{
    "unimol_train_path": "./unimol_feature/finetune_feature/train_output/train_data_molecular_features.npy",
    "mordred_train_path": "./mordred/taste_descriptors/train_processed.csv",
    "labels_train_path": "./Data/processed_data/train_data.csv",
    "output_base": "./ablation_output",
    "run_name": "ablation_mordred_only",
    "num_classes": 6,
    "input_dim": 300,
    "hidden_dim": 384,
    "query_dim": 64,
    "dropout": 0.25,
    "use_aux_loss": true,
    "aux_weight": 0.3,
    "infer_weights": [
        0.7,
        0.3
    ],
    "asl_gamma_neg": 1,
    "asl_gamma_pos": 0,
    "asl_clip": 0.05,
    "batch_size": 64,
    "num_epochs": 200,
    "lr": 0.0001,
    "weight_decay": 0.001,
    "max_grad_norm": 5.0,
    "num_warmup_epochs": 5,
    "noise_std": 0.03,
    "feat_mask_prob": 0.15,
    "use_mixup": true,
    "mixup_alpha": 0.2,
    "label_smoothing": 0.05,
    "use_smote": true,
    "smote_label_indices": [
        4,
        5
    ],
    "smote_k": 5,
    "smote_aug_factor": 4.0,
    "smote_aug_factor_per_label": {
        "4": 4.0,
        "5": 0.1
    },
    "use_ema": true,
    "ema_decay": 0.999,
    "use_weighted_sampler": false,
    "tune_thresholds": true,
    "threshold_grid_step": 0.02,
    "use_label_weights": true,
    "label_weight_power": 0.5,
    "label_weight_clip": 20.0,
    "es_monitor": "macro_f1",
    "n_folds": 5,
    "patience": 15,
    "random_state": 42,
    "use_amp": false,
    "mode": "mordred_only",
    "branch_type": "desc",
    "output_dir": "./ablation_mordred_only"
}